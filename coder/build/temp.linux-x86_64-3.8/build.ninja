ninja_required_version = 1.3
cxx = c++

cflags = -pthread -B /home/csmuli/anaconda3/compiler_compat -Wl,--sysroot=/ -Wsign-compare -DNDEBUG -g -fwrapv -O3 -Wall -Wstrict-prototypes -fPIC -I/home/csmuli/anaconda3/lib/python3.8/site-packages/torch/include -I/home/csmuli/anaconda3/lib/python3.8/site-packages/torch/include/torch/csrc/api/include -I/home/csmuli/anaconda3/lib/python3.8/site-packages/torch/include/TH -I/home/csmuli/anaconda3/lib/python3.8/site-packages/torch/include/THC -I/home/csmuli/anaconda3/include/python3.8 -c
post_cflags = -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=coder -D_GLIBCXX_USE_CXX11_ABI=0 -std=c++14
ldflags = 

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc



build /home/csmuli/CCN/coder/build/temp.linux-x86_64-3.8/python.o: compile /home/csmuli/CCN/coder/python.cpp
build /home/csmuli/CCN/coder/build/temp.linux-x86_64-3.8/BitIoStream.o: compile /home/csmuli/CCN/coder/BitIoStream.cpp
build /home/csmuli/CCN/coder/build/temp.linux-x86_64-3.8/ArithmeticCoder.o: compile /home/csmuli/CCN/coder/ArithmeticCoder.cpp





